# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4790

# MySQL connection string used by Prisma. Format:
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP's bundled MySQL/MariaDB defaults to root with NO password:
# mysql://root:@localhost:3306/card_games
DATABASE_URL="mysql://root:password@localhost:3306/card_games"

# Origin the Vite client dev server runs on, for CORS + Socket.IO.
CLIENT_ORIGIN=http://localhost:5173

# Used in later phases once auth ships. Generate long random strings for real use.
JWT_SECRET=change-me-dev-secret
JWT_REFRESH_SECRET=change-me-dev-refresh-secret
